{
  "name": "net-digital-art-museum",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-pages.mjs",
    "start": "node server/index.mjs",
    "preview": "node scripts/serve.mjs",
    "db:docker:setup": "node scripts/setup-postgresql-docker.mjs",
    "db:start": "docker compose --env-file .env.postgresql -f compose.postgresql.yml up -d",
    "db:stop": "docker compose --env-file .env.postgresql -f compose.postgresql.yml stop",
    "db:seed": "node database/seed-postgresql.mjs",
    "db:queries": "node scripts/run-queries.mjs",
    "db:check": "node scripts/check-database.mjs",
    "check": "node scripts/build-pages.mjs --check && node scripts/check-syntax.mjs && node --test tests/auth.test.mjs tests/core.test.mjs tests/validation.test.mjs tests/pg-config.test.mjs tests/media-storage.test.mjs tests/cloud-media.test.mjs",
    "test:integration": "node --test tests/postgresql.test.mjs tests/multimedia.test.mjs tests/cloud-uploads.test.mjs",
    "cloudinary:check": "node scripts/check-cloudinary.mjs",
    "media:migrate": "node scripts/migrate-cloudinary.mjs",
    "media:index": "node scripts/index-images.mjs",
    "test:cbir": "node scripts/evaluate-cbir.mjs",
    "db:neon:check": "node scripts/neon.mjs check",
    "db:neon:export": "node scripts/neon.mjs export",
    "db:neon:migrate": "node scripts/neon.mjs migrate",
    "media:publish": "node scripts/publish-uploads.mjs",
    "render:env": "node scripts/render-env.mjs",
    "start:neon": "node scripts/start-neon.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "cloudinary": "^2.11.0",
    "fflate": "^0.8.2",
    "ffprobe-static": "^3.1.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": "24.x"
  }
}
