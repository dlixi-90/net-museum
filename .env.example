# PostgreSQL installed locally. Create a dedicated UTF-8 database first.
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/net_museum
PG_SCHEMA=net_museum
PG_POOL_MAX=5
PG_CONNECT_TIMEOUT_MS=15000
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
NODE_ENV=development
ALLOW_ADMIN_SETUP=true
ADMIN_EMAILS=curator@example.test
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_STORAGE=local
# Render Free: UPLOAD_STORAGE=cloudinary; new media is stored outside the web service.
CLOUD_UPLOAD_MAX_MIB=100
