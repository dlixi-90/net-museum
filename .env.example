# Copy to .env for local development. Never commit .env.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=net_museum
HOST=127.0.0.1
PORT=3000
# Same origin as the Node.js website; set an https origin when deploying.
PUBLIC_ORIGIN=http://localhost:3000
# Initial admin setup is enabled only on a loopback-bound development server.
ALLOW_ADMIN_SETUP=true
NODE_ENV=development

# Cloudinary: Console > Settings > API Keys (server only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
