# Copy this template to .env; keep real credentials out of Git.
# Run npm run db:docker:setup to fill the three blank local database values.
DATABASE_URL=
POSTGRES_PASSWORD=
POSTGRES_PORT=5433
PG_SCHEMA=net_museum
PG_POOL_MAX=5
PG_CONNECT_TIMEOUT_MS=15000
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
NODE_ENV=development
ALLOW_ADMIN_SETUP=true
ADMIN_EMAILS=curator@example.test
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_STORAGE=local
# Render Free: UPLOAD_STORAGE=cloudinary; new media is stored outside the web service.
CLOUD_UPLOAD_MAX_MIB=100
# Optional deployment reference. The app still connects using DATABASE_URL.
# On Render, set DATABASE_URL to this Neon Direct URI in service Environment.
NEON_DATABASE_URL=
NEON_PG_SCHEMA=net_museum_import
