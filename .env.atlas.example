# Replace the placeholders locally with the URI from Atlas > Connect > Drivers.
# Use an Atlas database user, not your Atlas website login.
MONGODB_URI="mongodb+srv://<DB_USERNAME>:<DB_PASSWORD>@<CLUSTER_HOST>/net_museum?retryWrites=true&w=majority"
MONGODB_DB=net_museum
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
ALLOW_ADMIN_SETUP=true
NODE_ENV=development
